# ============================================================================
# DwarfTalk - AI-powered dwarf conversations
# ============================================================================
# Start systems on map load (fort mode)
dwarftalk/init
# Daemon check - restarts the notification daemon if it stopped
repeat --name dwarftalk_autostart --time 250 --timeUnits ticks --command [ dwarftalk/daemon_check ]
# ============================================================================
# KEYBINDINGS
# ============================================================================
# NOTE: Keybindings must be added to dfhack-config/init/dfhack.init
# Add these lines to your dfhack.init file:
#
# keybinding add Ctrl-T@dwarfmode dwarftalk/chat_window
# keybinding add Alt-Shift-S@dwarfmode dwarftalk/settings_window
#
# (Ctrl-Shift-S is DFHack's default "spectate toggle", so it is not used here.)
# ============================================================================
